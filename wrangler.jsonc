{
  // Used when deploying to Cloudflare Workers as a pure static-assets Worker
  // (no server-side code — everything runs client-side in the browser).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "authelia-oidc-client-generator",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
